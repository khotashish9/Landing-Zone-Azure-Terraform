tenant_id                    = "00000000-0000-0000-0000-000000000000"
management_subscription_id   = "11111111-1111-1111-1111-111111111111"
connectivity_subscription_id = "22222222-2222-2222-2222-222222222222"
identity_subscription_id     = "33333333-3333-3333-3333-333333333333"
corp_subscription_id         = null # set to place a workload subscription in Corp

prefix            = "alz"
root_display_name = "Contoso"
location          = "westeurope"
allowed_locations = ["westeurope", "northeurope", "global"]

tags = {
  CostCenter  = "platform"
  Environment = "prod"
  Owner       = "platform-team@contoso.com"
  ManagedBy   = "terraform"
}
required_tags = ["CostCenter", "Environment", "Owner"]

security_contact_email = "secops@contoso.com"
log_retention_days     = 365
firewall_sku           = "Standard"
policy_enforcement     = true # set false for an audit-only first run

